{
    "name": "ispeb/sistema-certificaciones",
    "description": "Sistema Institucional de Certificación con Código QR - ISPEB",
    "type": "project",
    "version": "1.0.0",
    "license": "proprietary",
    "authors": [
        {
            "name": "ISPEB - Instituto Superior Público Ezequiel Bujanda",
            "email": "admin@ispeb.gob.ve"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "phpoffice/phpspreadsheet": "^3.0",
        "endroid/qr-code": "^5.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "aplicacion/",
            "Configuracion\\": "configuracion/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-update-cmd": [
            "@composer dump-autoload --optimize"
        ]
    }
}
