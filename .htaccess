# =============================================================================
# KREDENTIA - Plataforma de Certificaciones y Credenciales QR
# Apache .htaccess | Front Controller + Seguridad Perimetral + Alto Rendimiento
# =============================================================================

# ── 1. Desactivar navegación de directorios (Previene Directory Listing) ──────
Options -Indexes -MultiViews
Options +FollowSymLinks

# ── 2. Bloquear archivos sensibles y de configuración explícitamente ─────────
<FilesMatch "^\.(env|git|htaccess|gitignore)|(composer\.(json|lock)|error\.log|.*\.(sql|bak|config|log|sh))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── 3. Motor de reescritura y Front Controller ───────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /docencia_qr/

    # 3.1. Prohibir acceso HTTP directo a carpetas con lógica privada y logs
    RewriteRule ^(aplicacion|configuracion|almacenamiento|database|vendor)(/.*)?$ - [F,L,NC]

    # 3.2. Permitir acceso directo si el archivo solicitado existe físicamente (/assets, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3.3. Si es un directorio existente sin index, canalizar a index.php
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ index.php [QSA,L]

    # 3.4. Front Controller: Todas las demás peticiones van a index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ── 4. Cabeceras HTTP de endurecimiento (Security Headers) ────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# ── 5. Compresión GZIP para respuestas (Acelera carga de transferencias) ─────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# ── 6. Caché persistente de recursos estáticos (1 Mes / 30 Días) ───────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 2 days"

    # Hojas de estilo y scripts (1 mes)
    ExpiresByType text/css                       "access plus 1 month"
    ExpiresByType application/javascript          "access plus 1 month"
    ExpiresByType text/javascript                 "access plus 1 month"

    # Imágenes y assets gráficos (1 mes)
    ExpiresByType image/png                       "access plus 1 month"
    ExpiresByType image/jpeg                      "access plus 1 month"
    ExpiresByType image/jpg                       "access plus 1 month"
    ExpiresByType image/webp                      "access plus 1 month"
    ExpiresByType image/svg+xml                   "access plus 1 month"
    ExpiresByType image/x-icon                    "access plus 1 month"

    # Fuentes web (1 año)
    ExpiresByType font/woff2                      "access plus 1 year"
    ExpiresByType font/woff                       "access plus 1 year"
    ExpiresByType application/font-woff           "access plus 1 year"
</IfModule>

# Cabecera complementaria Cache-Control para navegadores modernos
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico)$">
        Header set Cache-Control "max-age=2592000, public, must-revalidate"
    </FilesMatch>

    <FilesMatch "\.(woff2|woff|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
</IfModule>
