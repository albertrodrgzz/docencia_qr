# =============================================================================
# KREDENTIA - PLANTILLA DE CONFIGURACIÓN DE ENTORNO (.env.example)
# =============================================================================

# Entorno ('local' para desarrollo en Laragon, 'production' para despliegue en servidor real o Docker)
APP_ENV=production
APP_URL=https://tudominio.alwaysdata.net

# Configuración de Base de Datos MySQL (Producción / AlwaysData / Docker)
DB_HOST=mysql-kredentia.alwaysdata.net
DB_PORT=3306
DB_NAME=kredentia_ispeb
DB_CHARSET=utf8mb4
DB_USER=kredentia
DB_PASS=tu_clave_segura

# En desarrollo local Laragon (descomentar si se prefiere apuntar solo a local):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=ispeb_certificaciones
# DB_USER=root
# DB_PASS=
