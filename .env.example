# =============================================================================
# KREDENTIA - ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env)
# =============================================================================
# NOTA: En producción, configure APP_ENV=production y complete credenciales reales.
# =============================================================================

# Entorno de la aplicación ('local' | 'production')
APP_ENV=local
APP_URL=http://localhost/docencia_qr

# Configuración de Conexión a la Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ispeb_certificaciones
DB_CHARSET=utf8mb4
DB_USER=root
DB_PASS=
